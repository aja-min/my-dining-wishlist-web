# local: CSVを初期値に、ブラウザのlocalStorageへ保存。Google通信なし。
# google: 実際のGoogleログインとSheets APIを使用。再起動が必要。
DATA_MODE=local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAOTO_EMAIL=
# 複数アカウントはカンマ区切り（同じ変数を複数行にしない）
AZUSA_EMAIL=
NEXTAUTH_URL=http://localhost:3001
# openssl rand -base64 32 で生成。NEXT_PUBLIC_を付けない。
NEXTAUTH_SECRET=
GOOGLE_SPREADSHEET_ID=1Wm7dB8nt_BykgeZ2j5gLJqx5Xs67e2Y7vB2oJRFJZRE
GOOGLE_SHEET_TAB=お店

# 対象スプレッドシートを編集者として共有したサービスアカウント
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
